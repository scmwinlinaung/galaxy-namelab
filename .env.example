# Stripe Configuration
# Get your publishable key from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Test keys start with 'pk_test_', production keys start with 'pk_live_'
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# API Configuration
# Base URL for API endpoints
VITE_API_BASE_URL=https://api.galaxynamelab.com/name-lab/api
